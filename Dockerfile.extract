# Imagen de `extract`: docling + Tesseract (es) + Presidio/GLiNER. Se ejecuta SIN red, así que los modelos se
# descargan aquí, al construir, y el runtime arranca en modo offline. Contrato del cluster: DISENO-APPS §2.
FROM ghcr.io/astral-sh/uv:0.13-python3.14-trixie-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra extract --no-install-project
COPY src ./src
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --extra extract --no-editable
# Modelos horneados (única etapa con red): layout y tablas de docling, y GLiNER multilingüe para nombres.
ENV HF_HOME=/models/hf
RUN /app/.venv/bin/docling-tools models download --output-dir /models/docling layout tableformer \
 && /app/.venv/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download('urchade/gliner_multi_pii-v1')" \
 && /app/.venv/bin/python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('microsoft/mdeberta-v3-base')"

FROM python:3.14-slim-trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1000 app && useradd -u 1000 -g 1000 -M -d /nonexistent -s /usr/sbin/nologin app
COPY --from=build --chown=1000:1000 /app/.venv /app/.venv
COPY --from=build --chown=1000:1000 /models /models
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 TZ=America/Santiago \
    HF_HOME=/models/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DOCLING_ARTIFACTS_PATH=/models/docling \
    OMP_NUM_THREADS=2
WORKDIR /app
USER 1000:1000
ENTRYPOINT ["investigacion"]
CMD ["extract"]
